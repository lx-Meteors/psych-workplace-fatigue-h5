### Doubao / Volcengine Ark (Image Generation)
# Create an API Key in Volcengine Ark console, then set it here.
ARK_API_KEY="replace_me"

# Optional: override base url (default is cn-beijing)
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# Required: either a Model ID OR an Endpoint ID.
# - Model ID example (from your screenshot): doubao-seedream-3-0-t2i-250415
# - Endpoint ID example: ep-xxxxxxxxxxxxxxxx
ARK_IMAGE_MODEL_OR_ENDPOINT="replace_me"

### Cover output
COVER_OUT_FILE="src/assets/cover.png"

# Auto read title/subtitle/palette from current project (default 1).
# Set 0 if you want to provide COVER_TITLE/COVER_SUBTITLE/COVER_PRIMARY yourself.
COVER_FROM_PROJECT="1"

